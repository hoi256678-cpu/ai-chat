# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# git worktrees (superpowers subagent-driven-development)
.worktrees/

# ml-service (python)
ml-service/.venv/
ml-service/data/
ml-service/organized/
ml-service/ham_raw/
ml-service/*.pth
ml-service/classes.json
ml-service/*.log
ml-service/train_log*.txt
ml-service/serve_log.txt
ml-service/__pycache__/
ml-service/**/__pycache__/
.pytest_cache/
