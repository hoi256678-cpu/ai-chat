GEMINI_API_KEY=

# Optional: set to "ollama" to route AI replies to a local Ollama model
# instead of Gemini (dev/test only — Ollama only listens on localhost,
# so this has no effect on a deployed/Vercel build).
AI_PROVIDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Optional: local skin-classifier ml-service base URL (default http://localhost:8000).
# Dev-only — ml-service only listens on localhost, so this has no effect on
# a deployed/Vercel build (that path always falls back to text-only).
ML_SERVICE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakao Developers(developers.kakao.com) > 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
